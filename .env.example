# ========================================================
# PETTI REMITTANCE - ENVIRONMENT CONFIGURATION
# ========================================================

# Connection string for Neon PostgreSQL database:
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# Neon Storage Quota Limit (Optional, e.g. 0.5 or 0.5GB or 500MB)
NEON_STORAGE_LIMIT_GB=0.5

# ========================================================
# AI BUSINESS ASSISTANT CONFIGURATION
# ========================================================
AI_PRIMARY_PROVIDER=groq
AI_FALLBACK_PROVIDER=gemini

# Primary Provider: Groq (https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback Provider: Google Gemini (https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
